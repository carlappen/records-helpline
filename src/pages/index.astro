---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<main>
    <h1>Georgia Open Records Helpline</h1>
    <p>
        Navigating public records in Georgia can be confusing, frustrating and slow. 
        We're here to help — whether you're a journalist, researcher or just 
        a curious citizen trying to get information from your government.
    </p>

    <h2>What We Do</h2>
    <p>
        We offer free guidance on Georgia's Open Records Act, help you figure out what 
        to request and who to request it from, and can advise on what to do when agencies 
        push back or go silent. If you're working on a story, we can help with that too.
    </p>

    <h2>Get Help</h2>
    <p>
        Reach out any time. We're happy to talk through your situation, review a records 
        request or just point you in the right direction.
    </p>
    <ul>
        <li>Email: <a id="contact-email" href="#" rel="nofollow noopener">hello@recordshelpline.com</a></li>
    </ul>

    <script type="module">
        // Simple obfuscation to keep the email out of the raw HTML
        const codes = [104, 101, 108, 108, 111, 64, 114, 101, 99, 111, 114, 100, 115, 104, 101, 108, 112, 108, 105, 110, 101, 46, 99, 111, 109];
        const email = String.fromCharCode(...codes);
        const link = document.getElementById('contact-email');
        if (link) {
            link.href = `mailto:${email}`;
            link.textContent = email;
        }
    </script>

    <h2>Resources</h2>
    <p>
        Browse our blog for guides, tips, and real-world examples of navigating public 
        records in Georgia. More resources coming soon.
    </p>
    <p><a href="/resources">See resources →</a></p>
</main>
		</main>
		<Footer />
	</body>
</html>
