---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<meta http-equiv="refresh" content="0;url=/resources" />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>Resources moved</h1>
				<p>
					The resources previously hosted here have moved. You can find the current
					site of curated, external resources here:
				</p>
				<p><a href="/resources">Go to Resources</a></p>
			</section>
		</main>
		<Footer />
	</body>
</html>
